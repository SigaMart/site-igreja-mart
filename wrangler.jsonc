{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Site público estático + painel /admin e API /api no Worker (ver src/worker.ts).
  // Banco (DB), mídias (MIDIA) e sessões (SESSION) são criados sozinhos no primeiro deploy.
  "name": "igreja-mart",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    // Painel, API e mídias são páginas dinâmicas: vão direto para o Worker
    // (sem isso, o navegador recebia a página 404 do site estático).
    "run_worker_first": ["/admin/*", "/admin", "/api/*", "/midia/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "igreja-mart" }],
  "kv_namespaces": [{ "binding": "MIDIA" }, { "binding": "SESSION" }],
  // Agendador: a cada minuto envia as mensagens programadas no WhatsApp.
  "triggers": { "crons": ["* * * * *"] }
}
