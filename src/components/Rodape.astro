---
import { Image } from 'astro:assets';
import { SITE, NAV, mapsLink, fmtHora } from '../config/site';
import Icone from './Icone.astro';
import logo from '../assets/logo/logo-padrao-3x.png';
const ano = new Date().getFullYear();
const e = SITE.endereco;
---
<footer class="relative mt-24 overflow-hidden bg-tinta text-white/75">
  <div class="pointer-events-none absolute -top-40 -right-40 size-[28rem] rounded-full bg-laranja-500/15 blur-3xl"></div>

  <!-- Convite -->
  <div class="container-site relative">
    <div class="flex flex-col gap-6 border-b border-white/10 py-12 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <p class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Tem lugar pra você na <span class="text-laranja-400">MART</span>.</p>
        <p class="mt-2">Venha nos visitar em um dos cultos da semana. A gente te espera na porta.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/cultos/" class="btn btn-primario">Ver horários <Icone nome="seta" class="size-4" /></a>
        <a href={mapsLink} target="_blank" rel="noopener" class="btn border border-white/20 text-white hover:bg-white/10"><Icone nome="local" class="size-4" /> Como chegar</a>
      </div>
    </div>
  </div>

  <div class="container-site relative grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.1fr]">
    <div>
      <Image src={logo} alt="Logo da Igreja MART" width={120} height={108} class="h-14 w-auto" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed">
        Ministério Apostólico Restauração do Templo. Uma casa de portas abertas no bairro Fundação, em São Caetano do Sul.
      </p>
      <div class="mt-5 flex gap-2">
        <a href={SITE.redes.instagram} target="_blank" rel="noopener" class="flex size-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-laranja-500 hover:text-tinta" aria-label="Instagram da Igreja MART"><Icone nome="instagram" /></a>
        <a href={SITE.redes.facebook} target="_blank" rel="noopener" class="flex size-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-laranja-500 hover:text-tinta" aria-label="Facebook da Igreja MART"><Icone nome="facebook" /></a>
      </div>
    </div>

    <div>
      <h2 class="text-xs font-bold tracking-[0.14em] text-laranja-400 uppercase">Cultos</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {SITE.cultos.map((c) => (
          <li class="flex items-baseline justify-between gap-3 border-b border-white/5 pb-3 last:border-0">
            <span class="font-semibold text-white">{c.diaNome.split('-')[0]}</span>
            <span>{fmtHora(c.inicio)} às {fmtHora(c.fim)}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-bold tracking-[0.14em] text-laranja-400 uppercase">Navegue</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">
        {NAV.map((i) => <li><a href={i.href} class="transition hover:text-white">{i.label}</a></li>)}
        <li><a href="/oracao/" class="transition hover:text-white">Oração</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-bold tracking-[0.14em] text-laranja-400 uppercase">Onde estamos</h2>
      <address class="mt-4 text-sm leading-relaxed not-italic">
        <span class="text-white">{e.rua}</span><br />
        {e.bairro}, {e.cidade} - {e.uf}<br />
        CEP {e.cep}
      </address>
      <a href="/oracao/" class="mt-5 inline-flex items-center gap-2 rounded-2xl bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
        <Icone nome="maos" class="size-4 text-laranja-400" /> Precisa de oração? Fale com a gente
      </a>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {ano} Igreja MART · {SITE.nomeCompleto}</p>
      <p>igrejamart.com.br</p>
    </div>
  </div>
</footer>
