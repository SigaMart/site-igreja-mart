---
interface Props { itens: { p: string; r: string }[] }
const { itens } = Astro.props;
---
<div class="divide-y divide-tinta/10 card">
  {itens.map((it) => (
    <details class="group px-6 py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden">
        <h3>{it.p}</h3>
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-laranja-50 text-laranja-700 transition group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 text-tinta-suave">{it.r}</p>
    </details>
  ))}
</div>
