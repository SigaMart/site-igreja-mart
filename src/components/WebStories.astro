---
// Web Stories da MART: bolinha flutuante (arrastável e minimizável) que abre os stories em tela cheia.
// Os stories vêm do painel (/admin/stories/). Enquanto o painel não tiver nenhum, usa os padrões de src/lib/stories-padrao.ts.
import '../styles/stories.css';
import { storiesPadrao } from '../lib/stories-padrao';

const STORIES = await storiesPadrao();
---
<div class="ms-float" id="ms-stories" data-stories={JSON.stringify(STORIES)} hidden>
  <button class="ms-circle" type="button" aria-label="Abrir os stories da Igreja MART"><i></i></button>
  <button class="ms-min" type="button" aria-label="Minimizar os stories">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <span class="ms-count" aria-hidden="true"></span>
  <button class="ms-pill" type="button" aria-label="Mostrar os stories"><span><i></i></span>Stories</button>
</div>

<script>
  import { abrirPlayer, storiesVistos } from '../scripts/stories/player';
  import { aplicarCapa } from '../scripts/stories/render';
  import type { Story } from '../scripts/stories/tipos';

  const flutuante = document.getElementById('ms-stories') as HTMLElement;

  const naPagina = (paginas?: string[]) => {
    if (!paginas?.length) return true;
    const aqui = location.pathname.endsWith('/') ? location.pathname : location.pathname + '/';
    return paginas.some((p) => (p.endsWith('*') ? aqui.startsWith(p.slice(0, -1)) : aqui === p));
  };

  // Stories do painel (atualizados na hora); se não houver ou a rede falhar, usa os do build.
  async function carregar(): Promise<Story[]> {
    try {
      const r = await fetch('/api/stories/', { signal: AbortSignal.timeout(3000) });
      const lista = (await r.json()) as Story[];
      // Só os stories desta página (ou os globais)
      if (Array.isArray(lista) && lista.length) return lista.filter((s) => naPagina(s.paginas));
    } catch { /* usa o padrão */ }
    return JSON.parse(flutuante.dataset.stories || '[]');
  }
  const stories = await carregar();

  if (stories.length) {
    const circulo = flutuante.querySelector('.ms-circle') as HTMLButtonElement;
    const anel = circulo.querySelector('i') as HTMLElement;
    const contador = flutuante.querySelector('.ms-count') as HTMLElement;
    const pilula = flutuante.querySelector('.ms-pill') as HTMLButtonElement;
    const miniPilula = pilula.querySelector('i') as HTMLElement;
    const btnMin = flutuante.querySelector('.ms-min') as HTMLButtonElement;
    const POS = 'mart_stories_pos', MIN = 'mart_stories_min';
    const guardar = {
      ler: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
      gravar: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* ok */ } },
    };

    const atualizar = () => {
      const vistos = storiesVistos();
      const novo = stories.findIndex((s) => !vistos.includes(s.id));
      const primeiro = stories[novo >= 0 ? novo : 0];
      aplicarCapa(anel, primeiro.capa);
      aplicarCapa(miniPilula, primeiro.capa);
      flutuante.classList.toggle('vistos', novo < 0);
      const naoVistos = stories.filter((s) => !vistos.includes(s.id)).length;
      contador.textContent = String(naoVistos || stories.length);
      return novo >= 0 ? novo : 0;
    };
    let inicio = atualizar();

    // Posição: arrastável e lembrada entre as visitas (sem posição salva, fica no canto do CSS).
    let pos: { x: number; y: number } | null = null;
    const posicionar = () => {
      if (!pos || !innerWidth || !innerHeight) return;
      pos.x = Math.min(Math.max(8, pos.x), innerWidth - flutuante.offsetWidth - 8);
      pos.y = Math.min(Math.max(8, pos.y), innerHeight - flutuante.offsetHeight - 8);
      flutuante.style.left = `${pos.x}px`;
      flutuante.style.top = `${pos.y}px`;
      flutuante.style.bottom = 'auto';
    };
    const salvarPos = () => { if (pos && innerWidth && innerHeight) guardar.gravar(POS, JSON.stringify({ x: pos.x / innerWidth, y: pos.y / innerHeight })); };
    const setMin = (min: boolean) => {
      flutuante.classList.toggle('min', min);
      guardar.gravar(MIN, min ? '1' : '0');
      requestAnimationFrame(posicionar);
    };

    flutuante.hidden = false;
    flutuante.classList.toggle('min', guardar.ler(MIN) === '1');
    try {
      const salvo = JSON.parse(guardar.ler(POS) || 'null');
      if (salvo && innerWidth) { pos = { x: salvo.x * innerWidth, y: salvo.y * innerHeight }; posicionar(); }
    } catch { /* usa o canto padrão */ }
    addEventListener('resize', posicionar);
    setTimeout(() => flutuante.classList.add('in'), 900);

    const abrir = () => abrirPlayer(stories, inicio, () => { inicio = atualizar(); });

    // Arrastar: só vira "arrasto" depois de mover 6px; senão é um toque normal.
    let arrasto: { id: number; sx: number; sy: number; ox: number; oy: number; moveu: boolean } | null = null;
    flutuante.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.ms-min')) return;
      const r = flutuante.getBoundingClientRect();
      arrasto = { id: e.pointerId, sx: e.clientX, sy: e.clientY, ox: r.left, oy: r.top, moveu: false };
      flutuante.setPointerCapture(e.pointerId);
    });
    flutuante.addEventListener('pointermove', (e) => {
      if (!arrasto || e.pointerId !== arrasto.id) return;
      const dx = e.clientX - arrasto.sx, dy = e.clientY - arrasto.sy;
      if (!arrasto.moveu && Math.hypot(dx, dy) < 6) return;
      arrasto.moveu = true;
      flutuante.classList.add('arrastando');
      pos = { x: arrasto.ox + dx, y: arrasto.oy + dy };
      posicionar();
    });
    flutuante.addEventListener('pointerup', (e) => {
      if (!arrasto || e.pointerId !== arrasto.id) return;
      const foiArrasto = arrasto.moveu;
      arrasto = null;
      flutuante.classList.remove('arrastando');
      if (foiArrasto) { salvarPos(); return; }
      if (flutuante.classList.contains('min')) setMin(false);
      else abrir();
    });
    flutuante.addEventListener('pointercancel', () => { arrasto = null; flutuante.classList.remove('arrastando'); });
    circulo.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(); } });
    pilula.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setMin(false); } });
    btnMin.addEventListener('click', (e) => { e.stopPropagation(); setMin(true); });
  }
</script>
