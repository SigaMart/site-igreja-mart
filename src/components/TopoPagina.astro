---
// Cabeçalho padrão das páginas internas (com foto de fundo quando informada)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props {
  etiqueta: string;
  titulo: string;
  destaque?: string;
  texto?: string;
  migalhas?: { nome: string; url: string }[];
  foto?: ImageMetadata;
  fotoAlt?: string;
  /** Ajuste do enquadramento da foto, ex.: "center 30%" */
  posicao?: string;
}
const { etiqueta, titulo, destaque, texto, migalhas = [], foto, fotoAlt = '', posicao = 'center' } = Astro.props;
---
<section class:list={['relative isolate overflow-hidden', foto ? 'bg-tinta text-white' : 'border-b border-tinta/5 bg-gradient-to-b from-laranja-50 to-creme']}>
  {foto ? (
    <>
      <Image src={foto} alt={fotoAlt} widths={[800, 1400, 2000]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" style={`object-position:${posicao}`} loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-tinta/90 via-tinta/65 to-tinta/25"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-tinta/60 to-transparent"></div>
    </>
  ) : (
    <div class="pointer-events-none absolute -top-32 -right-32 size-96 rounded-full bg-laranja-200/40 blur-3xl"></div>
  )}
  <div class:list={['container-site relative', foto ? 'pt-20 pb-16 sm:pt-32 sm:pb-24' : 'py-14 sm:py-20']}>
    {migalhas.length > 0 && (
      <nav aria-label="Você está em" class:list={['mb-6 text-sm', foto ? 'text-white/70' : 'text-tinta-suave']}>
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class={foto ? 'hover:text-white' : 'hover:text-laranja-700'}>Início</a></li>
          {migalhas.map((m, i) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {i === migalhas.length - 1
                ? <span aria-current="page" class:list={['font-semibold', foto ? 'text-white' : 'text-tinta']}>{m.nome}</span>
                : <a href={m.url} class={foto ? 'hover:text-white' : 'hover:text-laranja-700'}>{m.nome}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <span class:list={['eyebrow', foto && 'text-laranja-300']}>{etiqueta}</span>
    <h1 class="titulo mt-5 max-w-3xl">{titulo}{destaque && <> <span class:list={['destaque', foto && 'text-laranja-400']}>{destaque}</span></>}</h1>
    {texto && <p class:list={['mt-4 max-w-2xl text-base sm:text-lg', foto ? 'text-white/85' : 'text-tinta-suave']}>{texto}</p>}
    <slot />
  </div>
</section>
