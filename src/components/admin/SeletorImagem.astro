---
// Campo de imagem do painel: mostra a prévia e abre a galeria (fotos do site, enviar, arrastar ou colar).
//  modo 'site'  (blog): valor = caminho da foto em src/assets; foto nova vai no campo `${name}_arquivo`.
//  modo 'midia' (stories etc.): valor = URL pública da imagem.
interface Props { name: string; valor?: string; previa?: string; modo?: 'site' | 'midia'; rotulo?: string }
const { name, valor = '', previa = '', modo = 'site', rotulo = 'Imagem' } = Astro.props;
const nomeAtual = valor.split('/').pop() ?? '';
---
<div data-seletor-imagem data-modo={modo} class="rounded-2xl transition">
  <span class="adm-rotulo">{rotulo}</span>
  <input type="hidden" name={name} value={valor} data-valor />
  {modo === 'site' && <input type="file" name={`${name}_arquivo`} accept="image/*" hidden data-arquivo-form />}
  <button type="button" data-escolher class="group mt-1.5 flex w-full items-center gap-3 rounded-2xl border border-dashed border-tinta/20 bg-creme p-2 text-left transition hover:border-laranja-400">
    <span class="relative flex aspect-[4/3] w-28 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-white">
      <img data-previa src={previa || undefined} hidden={!previa} alt="" class="size-full object-cover" />
      <span data-vazio hidden={!!previa} class="text-2xl text-tinta-suave">🖼️</span>
    </span>
    <span class="min-w-0 text-sm">
      <b class="block text-laranja-700 group-hover:underline">{previa ? 'Trocar imagem' : 'Escolher imagem'}</b>
      <span data-nome class="block truncate text-xs text-tinta-suave">{nomeAtual || 'Galeria, enviar ou arrastar aqui'}</span>
    </span>
  </button>
</div>

<script>
  import { ligarSeletores } from '../../scripts/admin/galeria';
  ligarSeletores();
</script>
