---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopoPagina from '../../components/TopoPagina.astro';
import fotoTopo from '../../assets/fotos/mart/louvor.jpg';
import CelularWhatsApp from '../../components/CelularWhatsApp.astro';
import Icone from '../../components/Icone.astro';
import { passagem } from '../../lib/biblia';
import { publicado } from '../../lib/publicado';

const lista = (await getCollection('devocionais', publicado)).sort((a, b) => +b.data.data - +a.data.data);
const [hoje, ...anteriores] = lista;
const vHoje = passagem(hoje.data.versiculo);
const dataBR = (d: Date) => d.toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
const migalhas = [{ nome: 'Devocionais', url: '/devocionais/' }];
---
<Base
  titulo="Devocionais diários: versículo, reflexão e oração"
  descricao="Devocionais diários da Igreja MART: um versículo da Bíblia, uma reflexão curta e uma oração para começar o dia com Deus. Leia e compartilhe no WhatsApp."
  migalhas={migalhas}
>
  <TopoPagina etiqueta="Devocionais" titulo="Devocionais" destaque="MART" texto="Um versículo, uma reflexão curta e uma oração. Leia pelo celular e mande no WhatsApp para quem você quiser." migalhas={migalhas} foto={fotoTopo} fotoAlt="Louvor durante um culto da noite na MART" posicao="center 35%" />

  <section class="container-site grid items-center gap-12 py-16 lg:grid-cols-[1.3fr_1fr]">
    <a href={`/devocionais/${hoje.id}/`} class="card group block p-8 sm:p-10">
      <span class="inline-flex items-center gap-2 rounded-full bg-laranja-500 px-3 py-1 text-sm font-bold">Mais recente</span>
      <p class="mt-5 text-sm font-semibold text-tinta-suave capitalize">{dataBR(hoje.data.data)}</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight group-hover:text-laranja-700">{hoje.data.titulo}</h2>
      <blockquote class="verso mt-6 border-l-4 border-laranja-500 pl-5 text-xl leading-snug">“{vHoje.texto}”</blockquote>
      <p class="mt-2 pl-6 text-sm font-bold text-laranja-700">{vHoje.referencia}</p>
      <p class="mt-6 text-tinta-suave">{hoje.data.descricao}</p>
      <span class="mt-6 inline-flex items-center gap-2 font-bold text-laranja-700">Ler devocional <Icone nome="seta" class="size-4 transition group-hover:translate-x-1" /></span>
    </a>
    <CelularWhatsApp titulo={hoje.data.titulo} versiculo={vHoje.texto} referencia={vHoje.referencia} trecho={hoje.data.descricao} />
  </section>

  {anteriores.length > 0 && (
    <section class="container-site">
      <h2 class="text-2xl font-extrabold">Devocionais anteriores</h2>
      <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {anteriores.map((d) => (
          <li>
            <a href={`/devocionais/${d.id}/`} class="card group flex h-full flex-col p-6">
              <p class="text-sm font-semibold text-tinta-suave capitalize">{dataBR(d.data.data)}</p>
              <h3 class="mt-2 text-xl font-extrabold group-hover:text-laranja-700">{d.data.titulo}</h3>
              <p class="mt-1 text-sm font-bold text-laranja-700">{d.data.versiculo}</p>
              <p class="mt-3 line-clamp-3 flex-1 text-sm text-tinta-suave">{d.data.descricao}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
