---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Compartilhar from '../../components/Compartilhar.astro';
import CriarStory from '../../components/CriarStory.astro';
import Icone from '../../components/Icone.astro';
import { SITE } from '../../config/site';
import { passagem } from '../../lib/biblia';
import { schemaArtigo } from '../../lib/schema';
import { publicado } from '../../lib/publicado';

export async function getStaticPaths() {
  const lista = (await getCollection('devocionais', publicado)).sort((a, b) => +b.data.data - +a.data.data);
  return lista.map((d, i) => ({ params: { slug: d.id }, props: { d, anterior: lista[i + 1], proximo: lista[i - 1] } }));
}
const { d, anterior, proximo } = Astro.props;
const { Content } = await render(d);
const v = passagem(d.data.versiculo);
const url = `/devocionais/${d.id}/`;
const dataBR = d.data.data.toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const migalhas = [{ nome: 'Devocionais', url: '/devocionais/' }, { nome: d.data.titulo, url }];

const textoWhats = [
  `☀️ *Devocional do dia · Igreja MART*`,
  ``,
  `*${d.data.titulo}*`,
  ``,
  `📖 _“${v.texto}”_`,
  `(${v.referencia})`,
  ``,
  d.data.descricao,
  ``,
  `🙏 *Oração:* ${d.data.oracao}`,
  ``,
  `💭 *Para pensar:* ${d.data.pergunta}`,
].join('\n');
---
<Base
  titulo={`${d.data.titulo} | Devocional`}
  descricao={d.data.descricao}
  tipo="article"
  migalhas={migalhas}
  jsonLd={[schemaArtigo({ titulo: d.data.titulo, descricao: d.data.descricao, url, data: d.data.data, autor: d.data.autor, tipo: 'Article' })]}
>
  <article class="container-site max-w-3xl py-14">
    <nav aria-label="Você está em" class="text-sm text-tinta-suave">
      <a href="/" class="hover:text-laranja-700">Início</a> / <a href="/devocionais/" class="hover:text-laranja-700">Devocionais</a>
    </nav>
    <p class="mt-8 text-sm font-semibold text-laranja-700 capitalize"><time datetime={d.data.data.toISOString().slice(0, 10)}>{dataBR}</time></p>
    <h1 class="titulo mt-3">{d.data.titulo}</h1>
    <p class="mt-4 text-base text-tinta-suave sm:text-lg">{d.data.descricao}</p>

    <figure class="mt-10 rounded-3xl bg-gradient-to-br from-laranja-500 to-laranja-400 p-8 sm:p-10">
      <p class="text-sm font-bold tracking-wider uppercase">Versículo base</p>
      <blockquote class="verso mt-3 text-2xl leading-snug sm:text-3xl">“{v.texto}”</blockquote>
      <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-4 font-bold"><a href={v.url} class="underline decoration-tinta/30 underline-offset-4 hover:decoration-tinta">{v.referencia}</a><CriarStory texto={v.texto} referencia={v.referencia} titulo={d.data.titulo} rotulo="Postar nos Stories" /></figcaption>
    </figure>

    <div class="prosa mt-10"><Content /></div>

    <section class="mt-12 rounded-3xl bg-tinta p-8 text-white sm:p-10">
      <h2 class="flex items-center gap-2 text-sm font-bold tracking-wider text-laranja-300 uppercase"><Icone nome="maos" class="size-5" /> Oração</h2>
      <p class="verso mt-4 text-xl leading-relaxed">{d.data.oracao}</p>
    </section>

    <section class="card mt-6 p-8">
      <h2 class="flex items-center gap-2 text-sm font-bold tracking-wider text-laranja-700 uppercase"><Icone nome="chat" class="size-5" /> Para pensar hoje</h2>
      <p class="mt-3 text-lg font-semibold">{d.data.pergunta}</p>
    </section>

    <section class="mt-10 border-t border-tinta/10 pt-8">
      <h2 class="font-extrabold">Abençoe alguém com este devocional</h2>
      <div class="mt-4"><Compartilhar texto={textoWhats} url={SITE.url + url} titulo={d.data.titulo} /></div>
      <div class="mt-6 flex flex-col gap-3 rounded-3xl bg-laranja-50 p-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-tinta-suave"><strong class="block text-base text-tinta">Poste o versículo nos Stories ou no Status</strong>Monte uma imagem com o fundo e as cores que preferir.</p>
        <CriarStory texto={v.texto} referencia={v.referencia} titulo={d.data.titulo} class="btn btn-primario shrink-0" />
      </div>
      <p class="mt-6 text-sm text-tinta-suave">Por {d.data.autor}</p>
    </section>

    <nav aria-label="Outros devocionais" class="mt-12 grid gap-4 sm:grid-cols-2">
      {anterior ? (
        <a href={`/devocionais/${anterior.id}/`} class="card group p-5"><span class="flex items-center gap-1 text-sm font-semibold text-tinta-suave"><Icone nome="setaEsq" class="size-3" /> Anterior</span><span class="mt-1 block font-bold group-hover:text-laranja-700">{anterior.data.titulo}</span></a>
      ) : <span />}
      {proximo && (
        <a href={`/devocionais/${proximo.id}/`} class="card group p-5 text-right"><span class="flex items-center justify-end gap-1 text-sm font-semibold text-tinta-suave">Próximo <Icone nome="seta" class="size-3" /></span><span class="mt-1 block font-bold group-hover:text-laranja-700">{proximo.data.titulo}</span></a>
      )}
    </nav>
  </article>
</Base>
