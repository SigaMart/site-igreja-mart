---
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
import { todos, executar, fmtSqlite, normalizarTelefone } from '../../lib/admin/db';

const STATUS = { novo: ['Novo', 'bg-laranja-50 text-laranja-700'], orando: ['Orando', 'bg-blue-50 text-blue-700'], respondido: ['Respondido', 'bg-green-50 text-green-700'] } as const;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const id = Number(f.get('id'));
  if (f.get('acao') === 'excluir') await executar('DELETE FROM pedidos_oracao WHERE id = ?', id);
  else await executar('UPDATE pedidos_oracao SET status = ?, anotacao = ? WHERE id = ?', String(f.get('status')), String(f.get('anotacao') ?? ''), id);
  return Astro.redirect(`/admin/oracao/${Astro.url.search}`);
}

const filtro = Astro.url.searchParams.get('status') ?? '';
const pedidos = await todos<{ id: number; nome: string; contato: string; motivo: string; pedido: string; quer_contato: number; status: keyof typeof STATUS; anotacao: string; criado_em: string }>(
  `SELECT * FROM pedidos_oracao ${filtro ? 'WHERE status = ?' : ''} ORDER BY id DESC LIMIT 200`, ...(filtro ? [filtro] : []));
const zap = (c: string) => { const t = normalizarTelefone(c); return !c.includes('@') && t.length >= 12 ? `https://wa.me/${t}` : null; };
---
<Admin titulo="Pedidos de oração">
  <nav class="mb-5 flex flex-wrap gap-2 text-sm">
    {[['', 'Todos'], ...Object.entries(STATUS).map(([k, v]) => [k, v[0]])].map(([k, r]) => (
      <a href={k ? `?status=${k}` : '?'} class:list={['btn adm-btn-p', filtro === k ? 'btn-escuro' : 'btn-contorno']}>{r}</a>
    ))}
  </nav>
  {pedidos.length ? (
    <ul class="grid gap-4 lg:grid-cols-2">
      {pedidos.map((p) => (
        <li class="adm-card">
          <div class="flex flex-wrap items-center gap-2 text-xs text-tinta-suave">
            <span class={`adm-selo ${STATUS[p.status]?.[1]}`}>{STATUS[p.status]?.[0]}</span>
            <b class="text-sm text-tinta">{p.nome || 'Anônimo'}</b> · {p.motivo} · {fmtSqlite(p.criado_em)}
          </div>
          <p class="mt-3 text-sm whitespace-pre-line">{p.pedido}</p>
          {p.contato && (
            <p class="mt-3 text-xs">
              {p.quer_contato ? <b class="text-laranja-700">Quer contato: </b> : 'Contato: '}
              {zap(p.contato) ? <a href={zap(p.contato)} target="_blank" class="font-bold underline">{p.contato} (WhatsApp)</a> : p.contato}
            </p>
          )}
          <form method="post" class="mt-4 flex flex-wrap items-end gap-2 border-t border-tinta/8 pt-4">
            <input type="hidden" name="id" value={p.id} />
            <label class="adm-rotulo min-w-40 flex-1 text-xs">Anotação da equipe<input name="anotacao" value={p.anotacao} class="adm-campo" /></label>
            <select name="status" class="adm-campo w-auto">{Object.entries(STATUS).map(([k, v]) => <option value={k} selected={p.status === k}>{v[0]}</option>)}</select>
            <button class="btn btn-escuro adm-btn-p">Salvar</button>
            <button name="acao" value="excluir" class="btn btn-contorno adm-btn-p text-red-700" data-confirmar="Excluir este pedido?">Excluir</button>
          </form>
        </li>
      ))}
    </ul>
  ) : <p class="adm-vazio">Nenhum pedido por aqui.</p>}
</Admin>
