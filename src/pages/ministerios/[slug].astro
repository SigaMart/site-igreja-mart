---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { SITE } from '../../config/site';
import { passagem } from '../../lib/biblia';
import { ID_IGREJA } from '../../lib/schema';

export async function getStaticPaths() {
  const lista = (await getCollection('ministerios')).sort((a, b) => a.data.ordem - b.data.ordem);
  return lista.map((m) => ({ params: { slug: m.id }, props: { m, outros: lista.filter((o) => o.id !== m.id) } }));
}
const { m, outros } = Astro.props;
const { Content } = await render(m);
const v = passagem(m.data.versiculo);
const migalhas = [{ nome: 'Ministérios', url: '/ministerios/' }, { nome: m.data.nome, url: `/ministerios/${m.id}/` }];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: `${m.data.nome} – ${SITE.nome}`,
  description: m.data.descricao,
  url: `${SITE.url}/ministerios/${m.id}/`,
  parentOrganization: { '@id': ID_IGREJA },
};
---
<Base titulo={`${m.data.nome} em São Caetano do Sul`} descricao={m.data.descricao} migalhas={migalhas} jsonLd={[schema]}>
  <section class="relative isolate overflow-hidden">
    <Image src={m.data.imagem} alt={m.data.imagemAlt} widths={[800, 1600]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="eager" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-tinta via-tinta/60 to-tinta/20"></div>
    <div class="container-site pt-24 pb-14 text-white sm:pt-40">
      <nav aria-label="Você está em" class="mb-6 text-sm text-white/70">
        <a href="/" class="hover:text-white">Início</a> / <a href="/ministerios/" class="hover:text-white">Ministérios</a> / <span aria-current="page" class="text-white">{m.data.nome}</span>
      </nav>
      <span class="eyebrow text-laranja-300">{m.data.publico}</span>
      <h1 class="titulo mt-5">{m.data.nome}</h1>
      <p class="mt-4 max-w-2xl text-base text-white/85 sm:text-lg">{m.data.chamada}</p>
    </div>
  </section>

  <div class="container-site grid gap-12 py-16 lg:grid-cols-[1.5fr_1fr]">
    <!-- O versículo aparece entre o 1º parágrafo e o restante do texto (ordem visual via CSS) -->
    <article class="prosa prosa-com-verso">
      <Content />
      <figure class="verso-meio rounded-3xl border-l-4 border-laranja-500 bg-laranja-50 px-6 py-5 sm:px-8">
        <blockquote class="verso text-xl leading-snug text-tinta sm:text-2xl">“{v.texto}”</blockquote>
        <figcaption class="mt-3 text-sm font-bold not-italic"><a href={v.url} class="text-laranja-700 no-underline hover:underline">{v.referencia}</a></figcaption>
      </figure>
    </article>
    <aside class="space-y-6">
      <div class="card p-6">
        <h2 class="font-extrabold">O que fazemos</h2>
        <ul class="mt-4 space-y-3">
          {m.data.atividades.map((a) => <li class="flex gap-3 text-tinta-suave"><Icone nome="check" class="mt-0.5 size-5 shrink-0 text-laranja-600" />{a}</li>)}
        </ul>
      </div>
      <div class="rounded-3xl bg-tinta p-6 text-white">
        <h2 class="font-extrabold">Quero participar</h2>
        <p class="mt-2 text-sm text-white/75">Fale com a gente depois de um culto ou mande uma mensagem.</p>
        <a href={SITE.redes.instagram} target="_blank" rel="noopener" class="btn btn-primario mt-4 w-full"><Icone nome="instagram" class="size-4" /> Falar no Instagram</a>
      </div>
    </aside>
  </div>

  <section class="container-site">
    <h2 class="text-2xl font-extrabold">Outros ministérios</h2>
    <ul class="mt-6 flex flex-wrap gap-3">
      {outros.map((o) => <li><a href={`/ministerios/${o.id}/`} class="btn btn-contorno">{o.data.nome}</a></li>)}
    </ul>
  </section>
</Base>
